{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airea.ai/schema/evidence-capsule-v0.1.schema.json",
  "title": "AIREA Evidence Capsule v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["capsule_type", "capsule_version", "capsule_id", "created_at", "title", "purpose", "record_refs", "receipt_refs", "probe_refs", "file_entries", "privacy", "provenance", "integrity", "reproduction", "limitations"],
  "properties": {
    "capsule_type": { "const": "airea.evidence_capsule" },
    "capsule_version": { "const": "0.1" },
    "capsule_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 1 },
    "work_ref": { "type": ["string", "null"], "pattern": "^AIREA-WORK-[0-9A-Z][0-9A-Z-]*$" },
    "record_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "receipt_refs": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9A-Z][0-9A-Z-]*$" } },
    "probe_refs": { "type": "array", "items": { "type": "string" } },
    "comparison_refs": { "type": "array", "items": { "type": "string" } },
    "conflict_set_refs": { "type": "array", "items": { "type": "string", "pattern": "^CS-[0-9A-Z][0-9A-Z-]*$" } },
    "file_entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "media_type", "byte_length", "sha256", "disclosure", "role"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+" },
          "media_type": { "type": "string" },
          "byte_length": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/digest" },
          "disclosure": { "enum": ["PUBLIC", "PRIVATE", "REDACTED", "UNAVAILABLE"] },
          "role": { "enum": ["RECORD", "RECEIPT", "PROBE", "OUTPUT", "COMPARISON", "PROVENANCE", "DOCUMENTATION", "SIGNATURE", "CONFLICT_SET", "OTHER"] }
        }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["raw_content_default", "redaction_method", "private_content_present"],
      "properties": {
        "raw_content_default": { "enum": ["PUBLIC", "PRIVATE", "REDACTED", "UNAVAILABLE"] },
        "redaction_method": { "type": ["string", "null"] },
        "private_content_present": { "type": "boolean" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "organization", "code_commit", "source_refs", "lineage_refs"],
      "properties": {
        "created_by": { "type": "array", "items": { "type": "string" } },
        "organization": { "type": ["string", "null"] },
        "code_commit": { "type": ["string", "null"] },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "lineage_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["canonicalization", "manifest_sha256", "sha256sums_path", "status"],
      "properties": {
        "canonicalization": { "type": "string" },
        "manifest_sha256": { "$ref": "#/$defs/digest" },
        "sha256sums_path": { "type": "string" },
        "signature_ref": { "type": ["string", "null"] },
        "transparency_ref": { "type": ["string", "null"] },
        "status": { "enum": ["VERIFIED", "UNVERIFIED", "FAILED"] }
      }
    },
    "reproduction": {
      "type": "object",
      "required": ["commands", "required_access", "limitations"],
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "required_access": { "type": "string" },
        "limitations": { "type": "array", "items": { "type": "string" } }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://airea.ai/schema/observation-record-v0.1.schema.json",
  "title": "AIREA Observation Record v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": ["record_type", "record_version", "observation_id", "observed_at", "recorded_at", "subject", "conditions", "probe", "input", "output", "trace", "claim_assertions", "evaluations", "provenance", "classifications", "integrity", "limitations"],
  "properties": {
    "record_type": { "const": "airea.observation_record" },
    "record_version": { "const": "0.1" },
    "observation_id": { "type": "string", "format": "uuid" },
    "observed_at": { "type": "string", "format": "date-time" },
    "recorded_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "required": ["identity_status"],
      "properties": {
        "provider": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] },
        "endpoint": { "type": ["string", "null"] },
        "declared_version": { "type": ["string", "null"] },
        "deployment_ref": { "type": ["string", "null"] },
        "identity_status": { "enum": ["DECLARED", "VERIFIED", "UNKNOWN"] }
      }
    },
    "conditions": {
      "type": "object",
      "required": ["probe_suite_version", "condition_status", "unavailable"],
      "properties": {
        "temperature": { "type": ["number", "null"] },
        "top_p": { "type": ["number", "null"] },
        "seed": { "type": ["integer", "null"] },
        "system_prompt_sha256": { "$ref": "#/$defs/digestOrNull" },
        "probe_suite_version": { "type": "string", "minLength": 1 },
        "tool_manifest_sha256": { "$ref": "#/$defs/digestOrNull" },
        "code_commit": { "type": ["string", "null"] },
        "runtime": { "type": ["object", "null"], "additionalProperties": true },
        "condition_status": { "enum": ["COMPLETE", "PARTIAL", "UNKNOWN"] },
        "unavailable": { "type": "array", "items": { "type": "string" } }
      }
    },
    "probe": {
      "type": "object",
      "required": ["suite_id", "suite_version", "case_id", "case_sha256"],
      "properties": {
        "suite_id": { "type": "string" },
        "suite_version": { "type": "string" },
        "case_id": { "type": "string" },
        "case_sha256": { "$ref": "#/$defs/digest" }
      }
    },
    "input": { "$ref": "#/$defs/contentEnvelope" },
    "output": { "$ref": "#/$defs/contentEnvelope" },
    "trace": {
      "type": "object",
      "properties": {
        "trace_id": { "type": ["string", "null"] },
        "span_id": { "type": ["string", "null"] },
        "tool_calls": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "retrievals": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "lineage_refs": { "type": "array", "items": { "type": "string" } },
        "event_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "claim_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertion_id", "claim_id", "relationship", "local_statement", "evidence_refs", "local_state", "scope", "rationale", "receipt_refs", "limitations"],
        "properties": {
          "assertion_id": { "type": "string", "pattern": "^A-[0-9A-Z][0-9A-Z-]*$" },
          "claim_id": { "type": "string", "pattern": "^C-[0-9A-Z][0-9A-Z-]*$" },
          "relationship": { "enum": ["SUPPORTS", "QUALIFIES", "CONTRADICTS", "REPRODUCES", "FAILS_TO_REPRODUCE", "DERIVED_FROM", "COMPUTED_BY", "ORIGINATES_FROM", "REQUIRES", "CHALLENGES", "RESPONDS_TO"] },
          "local_statement": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "local_state": { "enum": ["OBSERVED", "SUPPORTED", "INFERRED", "CONTESTED", "UNRESOLVED", "RETRACTED"] },
          "scope": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "receipt_refs": { "type": "array", "items": { "type": "string", "pattern": "^R-[0-9A-Z][0-9A-Z-]*$" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "evaluations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evaluation_id", "measure", "value", "method", "evaluator_type", "classification"],
        "properties": {
          "evaluation_id": { "type": "string" },
          "measure": { "type": "string" },
          "value": {},
          "unit": { "type": ["string", "null"] },
          "method": { "type": "string" },
          "evaluator_type": { "enum": ["DETERMINISTIC", "STATISTICAL", "HUMAN", "MODEL", "UNKNOWN"] },
          "evaluator_ref": { "type": ["string", "null"] },
          "evaluator_version": { "type": ["string", "null"] },
          "sample_size": { "type": ["integer", "null"], "minimum": 0 },
          "uncertainty": { "type": ["object", "null"], "additionalProperties": true },
          "classification": { "enum": ["COMPUTED", "EVALUATOR_DERIVED"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["created_by", "organization", "code_refs", "dataset_refs", "source_refs", "lineage_refs", "parent_record_refs"],
      "properties": {
        "created_by": { "type": "array", "items": { "type": "string" } },
        "organization": { "type": ["string", "null"] },
        "code_refs": { "type": "array", "items": { "type": "string" } },
        "dataset_refs": { "type": "array", "items": { "type": "string" } },
        "source_refs": { "type": "array", "items": { "type": "string" } },
        "lineage_refs": { "type": "array", "items": { "type": "string" } },
        "parent_record_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classifications": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["PUBLIC_REFERENCE", "PRIMARY_EVIDENCE", "SYNTHETIC", "MODELED", "DERIVED", "COMPUTED", "SPECIFICATION", "DEMONSTRATION", "REPRODUCTION", "EXTERNAL_VALIDATION", "OBSERVED", "DECLARED", "EVALUATOR_DERIVED", "INFERRED", "UNKNOWN"] },
      "uniqueItems": true
    },
    "integrity": {
      "type": "object",
      "required": ["canonicalization", "record_sha256", "manifest_ref", "integrity_status"],
      "properties": {
        "canonicalization": { "type": "string" },
        "record_sha256": { "$ref": "#/$defs/digest" },
        "manifest_ref": { "type": "string" },
        "integrity_status": { "enum": ["VERIFIED", "UNVERIFIED", "FAILED"] },
        "signature_ref": { "type": ["string", "null"] },
        "transparency_ref": { "type": ["string", "null"] },
        "signed_by": { "type": ["string", "null"] }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "digestOrNull": { "type": ["string", "null"], "pattern": "^sha256:[a-fA-F0-9]{64}$" },
    "contentEnvelope": {
      "type": "object",
      "required": ["sha256", "disclosure"],
      "properties": {
        "sha256": { "$ref": "#/$defs/digest" },
        "content_ref": { "type": ["string", "null"] },
        "disclosure": { "enum": ["PUBLIC", "PRIVATE", "REDACTED", "UNAVAILABLE"] },
        "media_type": { "type": ["string", "null"] },
        "byte_length": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  }
}
